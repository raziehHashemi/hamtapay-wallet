      "item": [
        {
          "name": "Create deposit (500,000 IRT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('depositId', body.depositId);",
                  "pm.collectionVariables.set('paymentToken', body.paymentUrl.split('/').pop());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
