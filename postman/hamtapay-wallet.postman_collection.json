{
  "info": {
    "name": "HamtaPay Wallet & Ledger (T-103)",
    "_postman_id": "6c1e5b0a-7d0e-4a7e-9b8f-2f4c1d3e5a90",
    "description": "Walks through every endpoint of the wallet service in order.\n\n1. `docker compose up --build`  2. import `hamtapay-local.postman_environment.json`  3. run the folders top to bottom (or the Collection Runner).\n\nAll amounts are strings: IRT = integer Toman, USDT = up to 6 decimals. Each money-moving POST sends a fresh `Idempotency-Key`.\n\nFolder 3 also plays the payer on the simulator payment page.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('userId')) {",
          "  pm.collectionVariables.set('userId', 'postman-' + Math.random().toString(36).slice(2, 10));",
          "  pm.collectionVariables.set('receiverId', 'postman-' + Math.random().toString(36).slice(2, 10));",
          "}"
        ]
      }
    }
  ],
