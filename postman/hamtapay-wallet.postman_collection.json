                "value": "{{$guid}}",
                "description": "required on every money-moving POST"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"amount\": \"500000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/deposits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "deposits"
              ]
            }
