# Copy to .env to override defaults (docker compose reads it automatically).

# Host ports
APP_PORT=3000
POSTGRES_PORT=5432
SIMULATOR_PORT=8080
RABBITMQ_UI_PORT=15672

# Simulator behaviour: off | default | hostile, and time acceleration (10 = everything 10x faster)
SIM_CHAOS=default
SIM_TIME_SCALE=1
SIM_ADMIN_KEY=local-admin-key

# Number of wallet-api instances behind the `app` load balancer
WALLET_REPLICAS=2

# When set, /internal/* and /reconciliation/* require header X-Internal-Api-Key
INTERNAL_API_KEY=

# Optional cooling-off period before a withdrawal is sent to the provider (cancellable meanwhile)
WITHDRAWAL_DISPATCH_DELAY_MS=0
